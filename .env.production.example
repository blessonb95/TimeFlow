# Production Environment Configuration Example
# When building for production (e.g., GitHub Pages), copy this to .env.production or set VITE_API_URL in your CI/CD (GitHub Actions / Netlify / Vercel secrets).

# Replace the URL below with the public URL of your deployed Express backend (e.g., on Render, Railway, or Fly.io)
VITE_API_URL=https://your-backend-service.onrender.com/api

# -----------------------------------------------------------------------------
# Backend AI Service Configuration (Set in server/.env or backend host secrets)
# NEVER expose AI_API_KEY, GEMINI_API_KEY, or OPENAI_API_KEY in frontend VITE_* variables!
# -----------------------------------------------------------------------------
# AI_ENABLED=true
# AI_PROVIDER=gemini                 # Supported: "gemini" or "openai"
# AI_API_KEY=your-secret-api-key     # Or set GEMINI_API_KEY / OPENAI_API_KEY on the server
# AI_MODEL=gemini-2.5-flash          # e.g. "gemini-2.5-flash" or "gpt-4o-mini"
# AI_BASE_URL=                       # Optional custom provider base URL
