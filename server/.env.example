# ─── Server Configuration ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── MySQL ────────────────────────────────────────────────────────────────────
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=timesheet_db
DB_SSL=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_the_same_value_as_VITE_ENCRYPTION_KEY

# Set VITE_ENCRYPTION_KEY to the same value in the frontend build environment.
# For Vercel, set VITE_API_URL=/api or leave it unset (the Vercel build uses /api).

# ─── CORS ────────────────────────────────────────────────────────────────────
# You can provide multiple comma-separated URLs (e.g., http://localhost:5173,https://your-username.github.io)
CLIENT_URL=http://localhost:5173,https://blesson-eglobe.github.io
