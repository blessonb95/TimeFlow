{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "timeflow-ui": true,
      "*": false,
      "**/*": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"timeflow-ui\" ]",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://timeflow-ugrr.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
